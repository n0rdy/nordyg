---
import Site from '../layouts/Site.astro';

const releases = 'https://github.com/n0rdy/nordyg/releases/latest';
const source = 'https://github.com/n0rdy/nordyg';
---
<Site home title="Nordyg, a DNS client for macOS" description="Nordyg is a free, open-source DNS client for macOS.">
  <section class="hero">
    <img class="mark" src="/logo-192.png" alt="" width="88" height="88" />
    <h1>Nordyg</h1>
    <p class="tagline">A DNS client for macOS</p>
    <div class="actions">
      <a class="btn primary" href={releases}>Download</a>
      <a class="btn" href={source}>GitHub</a>
    </div>
    <p class="brew"><code>brew install --cask n0rdy/n0rdy/nordyg</code></p>
    <p class="meta">Free and open source · macOS 14 or later · Intel and Apple silicon</p>
  </section>

  <figure class="screen">
    <picture>
      <source srcset="/screens/query-dark.png" media="(prefers-color-scheme: dark)" />
      <img src="/screens/query-light.png" width="2000" height="1258" decoding="async"
           alt="Nordyg showing every record type for example.com, asked over DNS over HTTPS and validated with DNSSEC" />
    </picture>
  </figure>
</Site>
