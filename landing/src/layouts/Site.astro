---
import '../styles/site.css';
interface Props { title: string; description: string; home?: boolean; }
const { title, description, home = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://nordyg.com/logo.png" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    {!home && (
      <header class="top">
        <a class="brand" href="/"><img src="/logo-96.png" alt="" width="28" height="28" />Nordyg</a>
      </header>
    )}
    <main>
      <slot />
    </main>
    <footer class="foot">
      <nav aria-label="Site">
        <a href="https://github.com/n0rdy/nordyg">GitHub</a>
        <a href="https://github.com/n0rdy/nordyg/discussions">Questions</a>
        <a href="/privacy/">Privacy</a>
      </nav>
      <p>Made by <a href="https://myko.n0rdy.foo">Myko Nordy</a>. Apple and macOS are trademarks of Apple Inc.</p>
    </footer>
  </body>
</html>
